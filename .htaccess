# Viraró Bodegón — sitio estático HTML/CSS

# Servir index.html como página principal
DirectoryIndex index.html

# Evitar listados de directorios
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquear PHP y las rutas antiguas de WordPress si quedara algún archivo en el hosting
    RewriteRule \.php(?:/|$) - [R=404,L,NC]
    RewriteRule ^(?:wp-admin|wp-includes|wp-content)(?:/|$) - [R=404,L,NC]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
